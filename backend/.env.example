# Hosted backend. Never commit real values.
# DATABASE_URL may be pooled; CHECKPOINT_DATABASE_URL MUST be direct/session pooled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/claimwise?sslmode=require
CHECKPOINT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/claimwise?sslmode=require
MODEL_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
JOB_BACKEND=postgres
CRON_SECRET=
APP_ORIGIN=https://YOUR-FRONTEND.vercel.app
ALLOWED_HOSTS=YOUR-BACKEND.vercel.app
NEATLOGS_ENABLED=false
MAX_UPLOAD_BYTES=4000000
MAX_PAGES=8
MODEL_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=240
