# Backend paths: preserved across deployments.
DATA_DIR=/home/ec2-user/claim-wise-backend/data
LOG_DIR=/home/ec2-user/claim-wise-backend/logs
FIXTURES_DIR=/home/ec2-user/claim-wise-backend/fixtures
REDIS_URL=redis://127.0.0.1:6379/0
# Set this to the exact URL of your separately hosted frontend.
APP_ORIGIN=http://127.0.0.1:5173
# Comma-separated API hostnames, without scheme or port.
ALLOWED_HOSTS=127.0.0.1,localhost
LLM_MODEL=gpt-6-luna
OAUTH_ACCOUNT=default
# Current auth code requires this loopback callback; use SSH forwarding.
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/chatgpt/callback
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=100
MAX_CONTEXT_CHARS=60000
MAX_REQUESTS=12
JOB_TIMEOUT_SECONDS=600
MODEL_TIMEOUT_SECONDS=90
MAX_MODEL_OUTPUT_CHARS=50000
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
NEATLOGS_ENABLED=false
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=claim-evidence-assistant
NEATLOGS_SAMPLE_RATE=1.0
NEATLOGS_SHUTDOWN_TIMEOUT_MS=5000
CRUSTDATA_API_KEY=
