# Optional override. Vercel production defaults to /api without this variable.
# Vercel forwards /api/* to the EC2 address in vercel.json.
# Do not set this to the HTTP EC2 URL on an HTTPS frontend (mixed content).
# VITE_API_BASE=/api

# Local development defaults to http://127.0.0.1:8000.
# To use a different local API, uncomment and edit:
# VITE_API_BASE=http://127.0.0.1:8000
